module DnsJson
  VERSION: String
end
module DNSJSON
  VERSION: String
  MEDIA_TYPE: String
  type json = nil | bool | Integer | Float | String | Array[json] | Hash[String, json]
  type object = Hash[String, json]
  class Error < StandardError
  end
  class ParseError < Error
  end
  class ConversionError < Error
  end
  class LimitError < ParseError
  end
  class ValidationError < Error
    attr_reader pointer: String
    def initialize: (String, ?pointer: String) -> void
  end
  class Problem < Data
    attr_reader offset: Integer
    attr_reader reason: String
  end
  def self.parse: (String, ?strict: bool, ?profile: Profile?, **Integer) -> Message
  def self.from_wire: (String, ?date: Time?, **Integer) -> Message
  class Message
    attr_reader problems: Array[Problem]
    attr_reader warnings: Array[ValidationError]
    def initialize: (?object, ?strict: bool, ?profile: Profile?, ?problems: Array[Problem], **Integer) -> void
    def []: (String | Symbol) -> json
    def to_h: () -> object
    def to_json: (*untyped, ?profile: Profile) -> String
    def to_wire: () -> String
    def malformed?: () -> bool
    def validate: () -> Array[ValidationError]
    def id: () -> Integer?
    def qname: () -> String?
    def qtype: () -> Integer?
    def qclass: () -> Integer?
    def name: () -> String?
    def type: () -> Integer?
    def klass: () -> Integer?
    def ttl: () -> Integer?
    def rdlength: () -> Integer?
    def opcode: () -> Integer?
    def rcode: () -> Integer?
    def qdcount: () -> Integer?
    def ancount: () -> Integer?
    def nscount: () -> Integer?
    def arcount: () -> Integer?
    def length: () -> Integer?
  end
  class RR < Message
  end
  class Pair < Message
    def initialize: (?object, ?query: Message?, ?response: Message?, **untyped) -> void
    def query: () -> Message?
    def response: () -> Message?
    def to_wire: () -> bot
  end
  class Profile
    FULL: Profile
    LOGGING: Profile
    PRIVACY: Profile
    def initialize: (?include: Array[Symbol], ?required: Array[String | Symbol], ?prohibited: Array[String | Symbol], ?one_bit_as: Symbol, ?privacy: bool) -> void
    def apply: (object) -> object
    def validate: (object) -> Array[ValidationError]
  end
  module Stream
    class Writer
      def initialize: (untyped, ?profile: Profile) -> void
      def <<: (Message) -> Writer
    end
    class Reader
      include Enumerable[Message]
      attr_reader problems: Array[Problem]
      attr_reader dropped_problems: Integer
      def initialize: (untyped, ?strict: bool, ?max_json_bytes: Integer, ?max_problems: Integer, **untyped) -> void
      def each: () { (Message) -> void } -> Reader
              | () -> Enumerator[Message, Reader]
    end
  end
  module Registry
    def self.type: (Integer) -> String
    def self.klass: (Integer) -> String
    def self.number: (String, ?Symbol) -> Integer
  end
end
